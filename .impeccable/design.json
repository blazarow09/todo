  "narrative": {
    "northStar": "The Ring Binder",
    "overview": "My Tasks is a small, always-on-top window that lives beside other work. It is designed like a personal organizer: each folder is a coloured tab divider, tasks are entries on a ruled leaf, the checkbox is a punched hole that fills with the divider's colour when an entry is done. Everything else stays quiet so the dividers do the wayfinding.\n\nThe window is narrow (360 to 600px) and glanced at many times a day, so hierarchy comes from size, weight and the divider colour, never from decoration. Ink is the only action colour. Vermilion is held back for overdue items and errors, so it always means something.",
    "keyCharacteristics": [
      "Seven divider hues assigned by folder order, used at full strength on tabs only.",
      "A fore-edge tab rail on the right that mirrors the folders and turns to one on click.",
      "Ruled rows, punched-hole checkboxes, mono stamps for dates and counts.",
      "Neutral leaf and page surfaces; ink buttons; one held-out danger colour.",
      "Fast, ease-out motion that confirms presses and never decorates."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Ink is the only action colour. Divider hues identify folders; they never become buttons.",
        "section": "colors"
      },
      {
        "name": "The Held-Out Red Rule",
        "body": "Danger appears only for overdue, errors and destructive actions, so it is never decorative.",
        "section": "colors"
      },
      {
        "name": "The Size-and-Weight Rule",
        "body": "Hierarchy comes from size and weight in one family. No second display face.",
        "section": "typography"
      },
      {
        "name": "The Float-Only Rule",
        "body": "Leaves, rows and tabs carry borders, not shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** assign divider hues by folder order and keep them on tabs, rules and checked holes.",
      "**Do** use mono stamps for any date, time or count.",
      "**Do** give every pressable element `scale(0.97)` on press with the 120ms ease-out curve.",
      "**Do** keep the custom background working: leaves become 82% opaque over it."
    ],
    "donts": [
      "**Don't** use a divider hue as a button or text colour.",
      "**Don't** use red for anything that is not overdue, an error or destructive.",
      "**Don't** add shadows to leaves or rows, or gradients and glows anywhere.",
      "**Don't** use emoji or hand-drawn SVG; icons come from the Iconify mdi set, outline variants."
    ]
  }
}